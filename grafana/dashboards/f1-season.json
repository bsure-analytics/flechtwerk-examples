  {
   "id": 3,
   "type": "table",
   "title": "Podiums — The Final Classification of Every Race",
   "description": "The classification is just the leaderboard read at the end of the tape: the board emits one final snapshot per driver when SessionStatus reaches 'Finalised', so an argMax over the whole session gives the result with no separate results feed involved.",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "label\\pos"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 380
       },
       {
        "id": "displayName",
        "value": "Race"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT label, drv, pos FROM (\n    SELECT s.label AS label, s.start_utc AS started,\n           argMax(f.tla, f.event_time)      AS drv,\n           argMax(f.position, f.event_time) AS pos\n    FROM flechtwerk.f1_standings AS f\n    INNER JOIN (SELECT session_key, label, start_utc FROM flechtwerk.f1_sessions FINAL\n                WHERE session_name = 'Race') AS s USING (session_key)\n    GROUP BY label, started, f.racing_number)\nWHERE pos BETWEEN 1 AND 3\nORDER BY started DESC, pos"
    }
   ],
   "transformations": [
    {
     "id": "groupingToMatrix",
     "options": {
      "columnField": "pos",
      "rowField": "label",
      "valueField": "drv"
     }
    }
   ]
  },
  {
   "id": 4,
   "type": "table",
   "title": "Season Tallies",
   "description": "Wins, podiums and points finishes counted from the same final classifications. Note this counts the races **you have ingested**, not the season — which is exactly the honest thing for a dashboard over a tape you chose the extent of.",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "wins"
      },
      "properties": [
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-background",
         "mode": "gradient"
        }
       },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          {
           "value": null,
           "color": "transparent"
          },
          {
           "value": 1,
           "color": "semi-dark-yellow"
          },
          {
           "value": 4,
           "color": "yellow"
          }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT drv, countIf(pos = 1) AS wins, countIf(pos <= 3) AS podiums,\n       countIf(pos <= 10) AS points_finishes, count() AS races\nFROM (\n    SELECT s.session_key AS sk,\n           argMax(f.tla, f.event_time)      AS drv,\n           argMax(f.position, f.event_time) AS pos\n    FROM flechtwerk.f1_standings AS f\n    INNER JOIN (SELECT session_key FROM flechtwerk.f1_sessions FINAL\n                WHERE session_name = 'Race') AS s USING (session_key)\n    GROUP BY sk, f.racing_number)\nWHERE pos > 0 AND drv != ''\nGROUP BY drv\nORDER BY wins DESC, podiums DESC, points_finishes DESC"
    }
   ]
  },
  {
   "id": 5,
   "type": "table",
   "title": "What Each Session's Tape Produced",
   "description": "A sanity panel, and a quiet demonstration of the emit-on-change rule: a race's TimingData feed carries ~68 000 lines, of which ~88 % only move a marshalling segment's status. The board emits a leaderboard row when a patch actually changed something about a driver, so a race lands ~37 000 rows here rather than ~150 000 near-duplicates.",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 10
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "label"
      },
      "properties": [
       {
        "id": "custom.width",
        "value": 340
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT s.label AS label, s.session_name AS session_name,\n       count() AS standings_rows, uniqExact(f.racing_number) AS drivers\nFROM flechtwerk.f1_standings AS f\nINNER JOIN (SELECT session_key, label, session_name, start_utc FROM flechtwerk.f1_sessions FINAL)\n    AS s USING (session_key)\nGROUP BY label, session_name, s.start_utc\nORDER BY s.start_utc DESC"
    }
   ]
  }
 ]
