   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "queryType": "table",
     "format": 0,
     "rawSql": "SELECT s.start_utc AS time,\n       if('${entity}' = 'driver', coalesce(nullIf(d.tla, ''), c.entity_id), c.entity_id) AS entity,\n       max(c.points) AS points\nFROM flechtwerk.f1_championship AS c\nINNER JOIN (SELECT session_key, start_utc FROM flechtwerk.f1_sessions FINAL) AS s\n    USING (session_key)\nLEFT JOIN (SELECT DISTINCT racing_number, argMax(tla, event_time) AS tla\n           FROM flechtwerk.f1_drivers FINAL GROUP BY racing_number) AS d\n    ON d.racing_number = c.entity_id\nWHERE c.entity_type = '${entity}' AND c.points IS NOT NULL\nGROUP BY time, entity\nORDER BY time"
    }
   ],
   "transformations": [
    {
     "id": "renameByRegex",
     "options": {
      "regex": "^points (.*)$",
      "renamePattern": "$1"
     }
    }
   ]
