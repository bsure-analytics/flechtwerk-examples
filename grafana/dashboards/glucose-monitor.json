{
  "uid": "flechtwerk-glucose",
  "title": "Flechtwerk — Glucose Monitor",
  "tags": [
    "flechtwerk",
    "glucose"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "patient",
        "label": "Patient",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "clickhouse"
        },
        "query": {
          "refId": "patient",
          "editorType": "sql",
          "rawSql": "SELECT DISTINCT patient_id FROM flechtwerk.glucose_readings ORDER BY patient_id"
        },
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Glucose",
      "description": "The latest live reading in mg/dL — what the Libre 3 app shows, one LibreLinkUp upload later. Coloured by the consensus ranges: <54 very low, 54–69 low, 70–180 in range, 181–250 high, >250 very high. Not a medical device: never dose from this.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "red",
                "value": 54
              },
              {
                "color": "green",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 180.5
              },
              {
                "color": "orange",
                "value": 250.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT argMax(mg_dl, measured_at) AS mg_dl FROM flechtwerk.glucose_readings WHERE kind = 'live' AND patient_id = '${patient}' AND measured_at > now() - INTERVAL 1 DAY"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Trend",
      "description": "LibreLinkUp's TrendArrow on the latest live reading: 1 falling fast … 3 stable … 5 rising fast.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "↓",
                  "index": 0
                },
                "2": {
                  "text": "↘",
                  "index": 1
                },
                "3": {
                  "text": "→",
                  "index": 2
                },
                "4": {
                  "text": "↗",
                  "index": 3
                },
                "5": {
                  "text": "↑",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT argMax(trend_arrow, measured_at) AS trend FROM flechtwerk.glucose_readings WHERE kind = 'live' AND patient_id = '${patient}' AND trend_arrow IS NOT NULL AND measured_at > now() - INTERVAL 1 DAY"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Age",
      "description": "How old the latest live reading is. The chain is sensor → phone (every minute) → LibreView → this poller (every minute), so a few minutes is normal; more means the phone is offline or out of Bluetooth range, or the ingest stage has stopped.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 300
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT dateDiff('second', max(measured_at), now64(3)) AS age FROM flechtwerk.glucose_readings WHERE kind = 'live' AND patient_id = '${patient}'"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Mean",
      "description": "Mean glucose (mg/dL) over the dashboard's time range, from the history series.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "dark-red",
                "value": null
              },
              {
                "color": "red",
                "value": 54
              },
              {
                "color": "green",
                "value": 70
              },
              {
                "color": "yellow",
                "value": 180.5
              },
              {
                "color": "orange",
                "value": 250.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT avg(mg_dl) AS mean FROM flechtwerk.glucose_readings WHERE kind = 'history' AND patient_id = '${patient}' AND $__timeFilter(measured_at)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "GMI",
      "description": "Glucose Management Indicator — the HbA1c the mean glucose predicts: 3.31 + 0.02392 × mean (mg/dL). Meaningful over 14 days or more of data; it is not a lab HbA1c.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT 3.31 + 0.02392 * avg(mg_dl) AS gmi FROM flechtwerk.glucose_readings WHERE kind = 'history' AND patient_id = '${patient}' AND $__timeFilter(measured_at)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "CV",
      "description": "Variability: the coefficient of variation — standard deviation over mean. The consensus target is 36 % or less.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 36
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT 100 * stddevPop(mg_dl) / avg(mg_dl) AS cv FROM flechtwerk.glucose_readings WHERE kind = 'history' AND patient_id = '${patient}' AND $__timeFilter(measured_at)"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Glucose (mg/dL) — live line, history points",
      "description": "`live` is the latest reading at each poll (about one a minute, with a trend arrow); `history` is LibreLinkUp's graphData series, which also covers any gap shorter than its 12-hour window. The shaded band is the 70–180 target range. The live line breaks across gaps longer than ten minutes instead of drawing a straight line through an outage.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 12,
        "w": 17,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 40,
          "max": 300,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "rgba(115, 191, 105, 0.15)",
                "value": 70
              },
              {
                "color": "transparent",
                "value": 180.5
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto",
            "spanNulls": 600000,
            "thresholdsStyle": {
              "mode": "area"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "history"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 4
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "timeseries",
          "format": 2,
          "rawSql": "SELECT measured_at AS time, if(kind = 'live', mg_dl, NULL) AS live, if(kind = 'history', mg_dl, NULL) AS history FROM flechtwerk.glucose_readings WHERE patient_id = '${patient}' AND $__timeFilter(measured_at) ORDER BY time"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Time in ranges",
      "description": "Share of the history series in each consensus range over the dashboard's time range. Targets: very low <1 %, low + very low <4 %, in range >70 %, high + very high <25 %, very high <5 %.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 12,
        "w": 7,
        "x": 17,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Very high >250"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "High 181–250"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "In range 70–180"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Low 54–69"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Very low <54"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT 100 * countIf(mg_dl > 250) / nullIf(count(), 0) AS `Very high >250`, 100 * countIf(mg_dl > 180 AND mg_dl <= 250) / nullIf(count(), 0) AS `High 181–250`, 100 * countIf(mg_dl >= 70 AND mg_dl <= 180) / nullIf(count(), 0) AS `In range 70–180`, 100 * countIf(mg_dl >= 54 AND mg_dl < 70) / nullIf(count(), 0) AS `Low 54–69`, 100 * countIf(mg_dl < 54) / nullIf(count(), 0) AS `Very low <54` FROM flechtwerk.glucose_readings WHERE kind = 'history' AND patient_id = '${patient}' AND $__timeFilter(measured_at)"
        }
      ]
    },
    {
      "id": 10,
      "type": "trend",
      "title": "Daily profile — last 14 days, by local hour",
      "description": "The ambulatory glucose profile: per hour of the phone's local day, the median with the 25–75 % and 5–95 % bands of the history series over the last 14 days. The local hour comes from each reading's own UTC offset, so a time-zone change does not smear the profile.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 11,
        "w": 13,
        "x": 0,
        "y": 17
      },
      "timeFrom": "14d",
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "never",
            "fillOpacity": 0,
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(p5|p25|median|p75|p95)$"
            },
            "properties": [
              {
                "id": "min",
                "value": 40
              },
              {
                "id": "max",
                "value": 300
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "median"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p75"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "p25"
              },
              {
                "id": "custom.fillOpacity",
                "value": 30
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p25"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "p5"
              },
              {
                "id": "custom.fillOpacity",
                "value": 12
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "light-blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p5"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "light-blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "hour",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toHour(addMinutes(measured_at, ifNull(utc_offset_min, 0))) AS hour, quantile(0.05)(mg_dl) AS p5, quantile(0.25)(mg_dl) AS p25, quantile(0.5)(mg_dl) AS median, quantile(0.75)(mg_dl) AS p75, quantile(0.95)(mg_dl) AS p95 FROM flechtwerk.glucose_readings WHERE kind = 'history' AND patient_id = '${patient}' AND $__timeFilter(measured_at) GROUP BY hour ORDER BY hour"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Days — last 14, by local day",
      "description": "One row per local day of the history series: how many points it holds, the mean, the time in, below and above range, and the extremes.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "h": 11,
        "w": 11,
        "x": 13,
        "y": 17
      },
      "timeFrom": "14d",
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_pct$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "day",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(toDate(addMinutes(measured_at, ifNull(utc_offset_min, 0)))) AS day, count() AS points, avg(mg_dl) AS mean, 100 * countIf(mg_dl >= 70 AND mg_dl <= 180) / count() AS in_range_pct, 100 * countIf(mg_dl < 70) / count() AS below_pct, 100 * countIf(mg_dl > 180) / count() AS above_pct, min(mg_dl) AS min, max(mg_dl) AS max FROM flechtwerk.glucose_readings WHERE kind = 'history' AND patient_id = '${patient}' AND $__timeFilter(measured_at) GROUP BY day ORDER BY day DESC"
        }
      ]
    }
  ]
}
