    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "editorType": "sql",
     "queryType": "table",
     "format": 1,
     "rawSql": "SELECT lap, tla, round(avg(lap_ms) OVER (PARTITION BY tla ORDER BY lap\n                       ROWS BETWEEN 4 PRECEDING AND CURRENT ROW) / 1000, 3) AS pace_s\nFROM flechtwerk.f1_laps\nWHERE session_key = ${session} AND racing_number IN (${drivers})\n  AND clean AND lap_ms IS NOT NULL\nORDER BY lap"
    }
   ],
